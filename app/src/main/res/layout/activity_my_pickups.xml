<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F0"
    android:padding="20dp">

    <!-- GREEN HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dashboard_welcome"
        android:padding="24dp"
        android:elevation="3dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚚 My Pickups"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Track your food rescue journey and make every delivery count."
            android:textColor="#E8F4EB"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

    <!-- SECTION HEADING -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="🌿 Your Pickup Tasks"
        android:textColor="#356B4B"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Manage your assigned pickups and deliveries."
        android:textColor="#8D6E63"
        android:textSize="13sp" />

    <!-- PICKUP STATUS GUIDE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:background="@drawable/bg_dashboard_badge"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 Pickup Progress"
            android:textColor="#356B4B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Assigned  →  Collected  →  Delivered"
            android:textColor="#477A59"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- LOADING INDICATOR -->
    <ProgressBar
        android:id="@+id/progressMyPickups"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:indeterminateTint="#477A59"
        android:visibility="gone" />

    <!-- EMPTY STATE -->
    <TextView
        android:id="@+id/tvEmptyMyPickups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_dashboard_card"
        android:padding="30dp"
        android:text="🚚 No pickups assigned yet.\n\nVisit Available Pickups to start your first food rescue!"
        android:gravity="center"
        android:textColor="#8D6E63"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

    <!-- SCROLLABLE PICKUP CARDS -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/myPickupsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />

    </ScrollView>

    <!-- BACK BUTTON -->
    <Button
        android:id="@+id/btnBackMyPickups"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="← Back to Dashboard"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#8D6E63" />

</LinearLayout>
